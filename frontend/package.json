{
  "name": "habits-tracker",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "bash scripts/fetch-fonts.sh",
    "start": "ng serve",
    "prebuild": "bash scripts/fetch-fonts.sh",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "bash scripts/fetch-fonts.sh",
    "test": "ng test --watch=false",
    "lint": "ng lint --max-warnings 0",
    "e2e": "bash ../scripts/e2e-preflight.sh && playwright test"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@jsverse/transloco": "8.4.0",
    "intl-messageformat": "12.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "jsdom": "^30.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
