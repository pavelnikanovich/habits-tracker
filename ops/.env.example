# Copy to .env next to compose.prod.yaml on the server (never commit .env) and fill in the values.
# The owner of the GitHub repository, lower case: the image is ghcr.io/<owner>/habits-tracker.
IMAGE_OWNER=
# The commit SHA of the image to run; the deployment sets it.
IMAGE_TAG=
# Hex, e.g. `openssl rand -hex 24`: it is part of a connection string, so no ';' or '='.
POSTGRES_PASSWORD=
# Base64 of 32 random bytes: `openssl rand -base64 32`. Production does not start without it.
IDENTITY_CODE_HASH_KEY=
RESEND_API_KEY=
